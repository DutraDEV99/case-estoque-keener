# Referência: exporte as variáveis no terminal ou configure-as na hospedagem.
# Este arquivo não é carregado automaticamente. Não coloque segredos no Git.
# DJANGO_SECRET_KEY deve receber uma chave própria, gerada conforme o README.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# HSTS: padrão 0 em desenvolvimento e 3600 em produção.
# DJANGO_HSTS_SECONDS=3600
# Ative somente se todos os subdomínios exigirem HTTPS e houver política de preload.
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# Ausente: SQLite local. Em produção, configure uma URL PostgreSQL privada.
# DATABASE_URL=
